{
  "name": "georgringer/news_random",
  "description": "Display random news records with EXT:news",
  "license": ["GPL-2.0-or-later"],
  "type": "typo3-cms-extension",
  "keywords": [
    "TYPO3",
    "extension",
    "news",
    "random"
  ],
  "authors": [
    {
      "name": "Georg Ringer",
      "homepage": "https://ringer.it",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "typo3/cms-core": "^13.4",
    "georgringer/news": "^12.0 || ^13.0 || ^14.0"
  },
  "autoload": {
    "psr-4": {
      "GeorgRinger\\NewsRandom\\": "Classes"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "news_random"
    }
  },
  "replace": {
    "typo3-ter/news_random": "self.version"
  }
}